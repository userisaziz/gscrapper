{
  "name": "gmaps-scraper-desktop",
  "version": "2.1.0",
  "description": "Google Maps Scraper Desktop App",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "dev": "npm run build:main && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "inject-config": "node scripts/inject-build-config.mjs",
    "build:main": "npm run inject-config && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build": "npm run build:main && vite build",
    "bundle:browsers": "node scripts/bundle-browsers.mjs",
    "build:win": "npm run build && npm run bundle:browsers && electron-builder --win",
    "build:mac": "npm run build && npm run bundle:browsers && electron-builder --mac",
    "build:linux": "npm run build && npm run bundle:browsers && electron-builder --linux",
    "build:all": "npm run build && npm run bundle:browsers && electron-builder --mac --win --linux",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "npm run inject-config && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.0",
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "playwright": "^1.49.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1"
  }
}
